{
  "name": "@pauleschwarz/visual-qa",
  "version": "0.1.0",
  "description": "Bounded browser QA for web apps: explore, find, fix, and prove with portable evidence.",
  "type": "module",
  "license": "MIT",
  "author": "Paul Schwarz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pauleschwarz/visual-qa.git"
  },
  "bugs": "https://github.com/pauleschwarz/visual-qa/issues",
  "homepage": "https://github.com/pauleschwarz/visual-qa#readme",
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "accessibility",
    "visual-regression",
    "ai-slop",
    "autonomous-agents",
    "web"
  ],
  "bin": {
    "visual-qa": "bin/visual-qa.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "docs/README.md",
    "docs/harness.md",
    "CONTRIBUTING.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "fixture": "node fixture/server.mjs",
    "selftest": "node --test --test-concurrency=1 test/e2e-fixture.mjs test/run-pipeline.e2e.mjs test/demo-report.test.mjs",
    "verify": "npm run test && npm run selftest",
    "verity": "pi-verity"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@pauleschwarz/pi-verity": "github:pauleschwarz/pi-verity#8fd92f80c8157149a59c4d61ef8ccc49b7361b87"
  },
  "engines": {
    "node": ">=20"
  }
}
